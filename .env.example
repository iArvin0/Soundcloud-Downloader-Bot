# Get this token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Runtime directories
DOWNLOAD_DIR=downloads
LOG_DIR=logs

# Number of downloads that may run at the same time.
MAX_CONCURRENT_DOWNLOADS=2

# Telegram Bot API sendAudio limit. Keep at 50 unless your API setup supports a different limit.
TELEGRAM_MAX_FILE_MB=50

# Optional. Only set this if ffmpeg/ffprobe are not available in PATH.
# Windows example: FFMPEG_LOCATION=C:\ffmpeg\bin
FFMPEG_LOCATION=
